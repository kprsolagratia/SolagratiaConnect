# ============================================================
#  SGKConnect — contoh konfigurasi
#  Salin berkas ini menjadi ".env" lalu isi nilainya.
#  Berkas .env TIDAK ikut ter-commit (sudah ada di .gitignore).
# ============================================================

# Supabase → Settings → API Keys
# Kosongkan keduanya untuk menjalankan mode demo.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# JANGAN pernah menaruh kunci service_role di sini.
# Kunci itu menembus semua aturan keamanan database.

# ---------- identitas ----------
CHURCH=GKKA-I Jemaat Sendawar
APP_NAME=SGKConnect

# true  = siapa pun boleh membuat akun sendiri
# false = akun hanya dibuat pengurus lewat Supabase Studio
ALLOW_SIGNUP=true
